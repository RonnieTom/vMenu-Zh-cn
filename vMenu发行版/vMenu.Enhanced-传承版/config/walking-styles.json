// 玩家可在「玩家 → 玩家外观 → 走路姿势」中选择的走路方式。
//
// 左侧是游戏加载的 clip set 名，右侧是菜单行显示文字，可按喜好填写。
//
// 可以自行添加。列表中的内容会直接交给游戏，因此服务器自带流式加载的 clip set
// 与 GTA 自带的用法相同。
//
// 注意适配的人物模型：clip set 是动画，动画按特定骨骼制作。move_m@ 适合男性，
// move_f@ 适合女性，都不适合狗之类。vMenu 允许在任意人物上尝试；若游戏无法加载
// 会如实提示，而不会假装成功。可全部提供，让玩家自己试出合适的。
//
// 玩家总会在列表顶部看到「正常」选项，用于恢复该人物自带走路姿势，无需自行添加。
{
  // 男性
  "move_m@casual@a": "休闲",
  "move_m@business@a": "商务",
  "move_m@tough_guy@": "硬汉",
  "move_m@gangster@a": "黑帮",
  "move_m@posh@": "优雅",
  "move_m@hipster@a": "潮人",
  "move_m@brave": "勇敢",
  "move_m@sad@a": "悲伤",
  "move_m@drunk@a": "微醉",
  "move_m@drunk@verydrunk": "烂醉",
  "move_m@injured": "受伤",
  "move_m@hurry@a": "匆忙",
  "move_m@money": "阔绰",

  // 女性
  "move_f@casual@a": "休闲（女）",
  "move_f@business@a": "商务（女）",
  "move_f@sexy@a": "泼辣",
  "move_f@femme@": "柔美",
  "move_f@gangster@ng": "黑帮（女）",
  "move_f@posh@": "优雅（女）",
  "move_f@sad@a": "悲伤（女）",
  "move_f@drunk@a": "微醉（女）",
  "move_f@injured": "受伤（女）",
  "move_f@maneater@": "交际花",

  // 通用
  "move_ped_crouched": "蹲姿",
