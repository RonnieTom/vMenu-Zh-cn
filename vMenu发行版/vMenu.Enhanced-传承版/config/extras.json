{
  // 为载具上带编号的额外件（extras）起可读名称。
  //
  // 外层键为载具生成名（小写），内层键为带引号的 extra id，值为菜单行要显示的文字。
  //
  // 这只会改显示名称，不会启用/禁用或添加 extra；载具没有的 id 根本不会出现。
  // id 范围 0–19，未写出的仍显示编号名称。
  //
  // 删除本文件也可以，所有 extra 会恢复为「Extra 1」「Extra 2」这类名称。

  "policecharger": {
    "1": "推杠",
    "2": "推杠包覆",
    "3": "警灯条",
    "4": "遮阳板灯",
    "5": "天线",
    "9": "后排灯光"
  },
  "policecvpi": {
    "1": "推杠",
